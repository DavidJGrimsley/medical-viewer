{
  "name": "medical-viewer",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node tools/compat/prepare-uri-decoder.cjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "start": "expo start --dev-client",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "typecheck": "tsc --noEmit",
    "expo-install-fix": "npx expo install --fix",
    "expo-doctor": "npx expo-doctor",
    "post-create-check": "npx expo install --fix && npx expo-doctor",
    "test": "npm run lint && npm run typecheck && npm run test:ar && npm run test:app && npm run test:quest && npm run test:ui && npm run test:dependencies",
    "test:quest": "node --experimental-strip-types --test tests/quest-*.test.cjs",
    "test:dependencies": "node --test tests/dependency-compat.test.cjs",
    "test:ui": "node --experimental-strip-types --test tests/game-ui.test.cjs",
    "test:ar": "node --experimental-strip-types --test tests/ar-session.test.cjs",
    "build:ios": "expo export --platform ios --max-workers 2",
    "react:check": "react-doctor -y --no-telemetry",
    "build": "npm run build:ios",
    "test:app": "node --experimental-strip-types --test tests/medical-*.test.cjs",
    "build:android": "expo export --platform android --max-workers 2",
    "ci:verify": "npm test && npm run build:ios && npm run build:android",
    "test:medical:shader": "node --experimental-strip-types tools/medical/test_volume_shader.cjs"
  },
  "dependencies": {
    "@expo/log-box": "^57.0.4",
    "@expo/ui": "~57.0.23",
    "@reactvision/react-viro": "^3.0.3",
    "decode-uri-component": "0.5.0",
    "expo": "~57.0.28",
    "expo-asset": "~57.0.19",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-navigation-bar": "~57.0.3",
    "expo-router": "~57.0.26",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/node": "^25.9.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
    "react-doctor": "^0.9.12",
    "typescript": "~6.0.3",
    "playwright-core": "1.64.0"
  },
  "overrides": {
    "query-string@7.1.3": {
      "decode-uri-component": "$decode-uri-component"
    },
    "xcode@3.0.1": {
      "uuid": "11.1.1"
    }
  },
  "private": true,
  "description": "Explore anatomy, registered scan slices, and experimental scan volumes in AR.",
  "repository": {
    "type": "git",
    "url": "https://github.com/DavidJGrimsley/medical-viewer.git"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
